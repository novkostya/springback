#!/bin/sh
# fly-deploy — deploy the public demo to fly.io with the pins deploy/Dockerfile needs.
#
# WHY THIS EXISTS, when `flyctl deploy` looks like it should be enough.
#
# flyctl knows nothing about versions.env, so every ARG the Dockerfile declares WITHOUT a default
# arrives empty. springback has already paid for this once, in the release workflow, and the error
# named nothing that was actually wrong:
#
#   RUN git clone --depth 1 --branch ${IDEVICEINSTALLER_REF} https://github.com/… /src/ii
#   fatal: repository '.' does not exist          (exit code 128)
#
# With the ref empty, `--branch` swallows the URL and git reads the DESTINATION as the repository
# to clone. So an unset build-arg presents as "that repository does not exist", pointing at the one
# path on the line that is not the problem.
#
# THE ARG LIST IS DERIVED FROM THE DOCKERFILE, not written out here. A hand-written list is how
# this recurs: somebody adds an ARG, the Makefile is updated because that is where builds are
# tested, and only the demo deploy is quietly short one value. Reading `^ARG` means a new pin is
# either found in versions.env or REPORTED — never silently empty.
set -eu

cd "$(dirname "$0")/.."

[ -f versions.env ] || { echo "fly-deploy: no versions.env — run this from a springback checkout" >&2; exit 2; }
[ -f fly.toml ] || { echo "fly-deploy: no fly.toml — run this from a springback checkout" >&2; exit 2; }
command -v flyctl >/dev/null 2>&1 || {
	echo "fly-deploy: flyctl is not on PATH. This runs where flyctl is installed and" >&2
	echo "            authenticated: the CI runner, or your own machine. The session box" >&2
	echo "            has neither (deploy/demo.md)." >&2
	exit 2
}

set --
defaulted=''
missing=''

# A NAME IS DEFAULTED IF **ANY** LINE DEFAULTS IT, which is not the same as the line in front of
# you. A multi-stage Dockerfile declares a global ARG once with its default and then re-declares it
# BARE inside each stage that needs it, because an ARG before the first FROM is out of scope
# afterwards. So `ARG PIN_HINT` appears three times with no `=` and once with one.
#
# Judging each line on its own made this script demand a versions.env entry for PIN_HINT — which is
# a help string, not a pin. Caught on the first run, and the failure was the honest kind: it
# refused to deploy rather than passing something empty.
defaults=$(grep '^ARG ' deploy/Dockerfile | sed -n 's/^ARG \([A-Za-z0-9_]*\)=.*/\1/p' | sort -u)

# Fed by a here-doc rather than a pipe: `… | while read` runs the loop in a SUBSHELL, so every
# `set --` below would be discarded at the `done` and the deploy would carry no build-args at all.
while IFS= read -r name; do
	[ -n "$name" ] || continue
	has_default=no
	for d in $defaults; do
		[ "$d" = "$name" ] && has_default=yes && break
	done

	# VERSION is not a pin. It is what this build IS, and it is passed below.
	[ "$name" = VERSION ] && continue

	# The first match wins, matching `.`-sourcing semantics.
	value=$(sed -n "s/^${name}=//p" versions.env | head -n 1)
	if [ -n "$value" ]; then
		set -- "$@" --build-arg "${name}=${value}"
	elif [ "$has_default" = yes ]; then
		defaulted="$defaulted $name"
	else
		missing="$missing $name"
	fi
done <<EOF
$(grep '^ARG ' deploy/Dockerfile | sed 's/^ARG //; s/=.*//' | sort -u)
EOF

if [ -n "$missing" ]; then
	echo "fly-deploy: deploy/Dockerfile declares ARGs with no default and no versions.env entry:" >&2
	echo "           $missing" >&2
	echo "           Add them to versions.env — an empty build-arg fails later, somewhere unrelated." >&2
	exit 1
fi
[ -n "$defaulted" ] && echo "fly-deploy: using the Dockerfile's own defaults for:$defaulted"

# THE DEMO SAYS WHAT IT IS BUILT FROM. Without this the footer reads 0.0.0-dev — the same string a
# laptop build carries — so nobody looking at the running demo can tell which commit it is.
version=$(git describe --tags --always --dirty 2>/dev/null || echo unknown)
set -- "$@" --build-arg "VERSION=demo-${version}"

app=$(sed -n 's/^app *= *"\(.*\)"/\1/p' fly.toml | head -n 1)
[ -n "$app" ] || { echo "fly-deploy: no app name in fly.toml" >&2; exit 2; }

# machine_count prints the number of machines, or nothing at all if it cannot find out.
#
# THE DIFFERENCE BETWEEN "WRONG" AND "UNKNOWN" IS THE WHOLE DESIGN HERE. A deploy token is narrow
# by design and may not be allowed to list machines; jq may be absent. Neither is a broken topology,
# and failing a nightly deploy on an unverified assumption about flyctl's output shape would be a
# worse bug than the one this guards. So: silence means "could not check", and the caller says so
# out loud rather than treating it as a pass.
machine_count() {
	command -v jq >/dev/null 2>&1 || return 0
	out=$(flyctl machines list -a "$app" --json 2>/dev/null) || return 0
	printf '%s' "$out" | jq -e 'if type == "array" then length else empty end' 2>/dev/null || return 0
}

# EXACTLY ONE MACHINE, AND IT IS A CORRECTNESS CONSTRAINT RATHER THAN A BILL.
#
# quince ran its demo on two and login became a coin flip (quince#636): sessions live in each
# machine's own memory, so a login lands on machine A, the next request lands on machine B, and B
# has never heard of that session — "I pressed Sign in and it put me back on Sign in". springback is
# the same shape and then some, because each machine also seeds its OWN /tmp/springback-demo, so the
# library would differ between refreshes.
#
# What makes it worth a check rather than a note: the logs of neither machine show anything wrong.
# A logs a successful login; B logs a routine 401 for an unknown session, indistinguishable from an
# expired cookie. The defect exists only in the pair, and reading one machine's log — the natural
# thing to do — cannot find it.
#
# THE COUNT IS NOT EXPRESSIBLE IN fly.toml. There is no count key; auto_stop_machines and
# min_machines_running shape behaviour without capping it. So the constraint is carried entirely by
# whoever last ran `fly scale count`, and a scale-up would reintroduce this silently. quince filed
# the enforcement as quince#637 and it is still open; this is that check, before the deploy rather
# than after the incident.
n=$(machine_count)
case "$n" in
"") echo "fly-deploy: could not read the machine count (no jq, or the token may not list machines)." >&2
    echo "            Check by hand: flyctl machines list -a $app — it must be exactly one." >&2 ;;
0|1) : ;; # 0 is a first deploy: there is nothing there yet.
*)  if [ "${SPRINGBACK_ALLOW_MANY_MACHINES:-}" = 1 ]; then
	echo "fly-deploy: $n machines, continuing because SPRINGBACK_ALLOW_MANY_MACHINES=1." >&2
    else
	echo "fly-deploy: REFUSING — $app is running $n machines and this demo requires exactly one." >&2
	echo "            Sessions live in each machine's memory and each seeds its own state, so" >&2
	echo "            visitors are balanced between two different demos and login works or not" >&2
	echo "            depending on which one answers. Neither machine's log shows anything wrong." >&2
	echo "            Fix:  flyctl scale count 1 -a $app" >&2
	echo "            Override, deliberately:  SPRINGBACK_ALLOW_MANY_MACHINES=1 $0" >&2
	exit 1
    fi ;;
esac

# --ha=false because fly's default for a FIRST deploy is two machines — the same two this refuses
# above, so without it the first deploy would create the state the next one rejects.
#
# --remote-only: this image builds ipatool, ideviceinstaller and two small C programs from source.
# fly's builder does it with a warm cache; a GitHub runner would do it from cold every night.
echo "fly-deploy: deploying $version to $app"
flyctl deploy --remote-only --ha=false "$@"

# And again afterwards, because the deploy itself is the thing most likely to have added one.
#
# ONLY "TOO MANY" IS A FAULT HERE. Zero is not: it is what a stub, an API still catching up, or a
# deploy flyctl has already reported as failed all look like — and the first run of this script
# exited 1 on exactly that, having deployed successfully. A guard that fails the first deploy of
# every new app is a guard nobody keeps.
n=$(machine_count)
case "$n" in
""|0|1) : ;;
*) echo >&2
   echo "fly-deploy: WARNING — $app now has $n machines. The deploy succeeded, but the demo is" >&2
   echo "            only correct at one: flyctl scale count 1 -a $app" >&2
   exit 1 ;;
esac
