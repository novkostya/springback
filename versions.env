# springback — single source of truth for toolchain versions AND container image refs.
#
# Consumed in exactly two places:
#   - Makefile     `include versions.env`  → every gate runs inside these images
#   - Dockerfile   via `--build-arg` passed by the Makefile (defaults below mirror these)
#
# The dev host is a PURE CONTAINER HOST (nerdctl + containerd, no toolchains installed). The
# convention is quince's and the reasoning is quince's: dev and the release image compile with
# byte-identical toolchains because the gates run inside the Dockerfile's own build stages.
#
# ONE Alpine line — 3.24 — across build and runtime, matching quince. springback shares a host
# with quince and speaks to the same devices; sharing the Alpine line means the libimobiledevice
# family here is the same one quince links against, which is one fewer way for behaviour on the
# wire to diverge.

# --- Versions (human-facing pins) ---
GO_VERSION=1.26.5
GOLANGCI_LINT_VERSION=2.12.2
ALPINE_VERSION=3.24

# ipatool — the Apple Store client springback shells out to (MIT, Go). Built from source in a Go
# stage rather than pulled as a release asset: the release tarballs are glibc-linked amd64 builds
# and the runtime here is musl. `go install` against the pinned Go gives a static musl binary.
IPATOOL_REF=v2.3.2

# ideviceinstaller — NOT PACKAGED IN ALPINE 3.24. Verified live against the v3.24 main+community
# APKINDEX (2026-08-11): `apk search -x ideviceinstaller` returns nothing there; the package
# exists only in edge/testing, at this same 1.2.0. Building the pinned tag from source is the
# quince precedent (its libimobiledevice stage) and keeps the pin explicit rather than tracking
# whatever edge holds on any given day.
IDEVICEINSTALLER_REF=1.2.0

# --- Toolchain images (gate containers == production Dockerfile build stages) ---
GO_IMAGE=golang:1.26.5-alpine3.24
ALPINE_IMAGE=alpine:3.24

# There is no Node line here, deliberately. springback's UI is three hand-written static files
# embedded with go:embed — no bundler, no lockfile, no toolchain image. "Anything pretty" is
# explicitly out of v0.1 (SPEC §1), and a build step for 40 KB of static assets would cost more
# than the whole screen it renders.
